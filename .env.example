# 复制成 .env.local（已被 .gitignore 忽略），填入自己的值后使用：
#   cd /data/user/0/cc.codroid/files/home/workspace/stock-watch
#   cp .env.example .env.local
#   set -a; source .env.local; set +a
#   python3 watch.py --test-mail
#
# 注意：.env.local 里有授权码，不要提交到任何仓库。

export STOCK_SECID=1.600378
export TARGET_PRICE=40.00
export DIRECTION=up

# 邮件通道（默认）
export NOTIFY_CHANNEL=email
export SMTP_HOST=smtp.qq.com
export SMTP_PORT=465
export SMTP_USER=your-qq-number@qq.com
export SMTP_PASS=你的QQ邮箱授权码
export MAIL_TO=your-qq-number@qq.com
export MAIL_FROM=your-qq-number@qq.com

# ntfy 备选通道（当前网络下 ntfy.sh 被拦截，需要 VPN）
# export NOTIFY_CHANNEL=ntfy
# export NTFY_SERVER=https://ntfy.sh
# export NTFY_TOPIC=你的随机主题
# export NTFY_PRIORITY=4
